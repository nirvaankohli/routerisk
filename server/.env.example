# Set these on the server. Do not put Twilio credentials in the iPhone app.
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_API_KEY_SID=SK_your_api_key_sid
TWILIO_API_KEY_SECRET=your_api_key_secret
# Alternatively, omit both API key lines and set TWILIO_AUTH_TOKEN.
TWILIO_FROM_NUMBER=+15550000000
PARENT_PHONE=+15551112222
ROUTERISK_PAIRING_TOKEN=generate_a_long_random_token
PORT=8787
HOST=127.0.0.1
