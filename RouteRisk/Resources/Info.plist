<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>RouteRisk</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>com.routerisk.app</string>
    <key>CFBundleName</key><string>RouteRisk</string>
